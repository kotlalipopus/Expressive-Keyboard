{
  "id": "builtin.neumorph",
  "name": "Неоморфизм",
  "version": "4.0",
  "author": "Expressive Keyboard",
  "description": "Мягкие скульптурные клавиши с деликатным светом, бархатными тенями и тактильным вдавливанием. Светлый и тёмный вариант.",
  "icon": "☁️",
  "skin": {
    "keyboard": {
      "background": {
        "colors": ["#EEF2F8", "#E4EAF3"],
        "angle": 160
      },
      "corner": 28
    },
    "colors": {
      "background": "#E9EEF6", "key": "#EEF2F8", "keyText": "#2D3548",
      "func": "#E2E8F2", "funcText": "#5B6682", "accent": "#5B6EF5", "accentText": "#FFFFFF"
    },
    "keys": {
      "*": {
        "material": "neumorph",
        "background": { "colors": ["#F7F9FD", "#E2E8F2"], "angle": 135 },
        "pressedBackground": { "colors": ["#DCE3EE", "#EEF2F8"], "angle": 135 },
        "border": "#B3FFFFFF",
        "borderWidth": 0.8,
        "shadow": 7,
        "shadowY": 3.5,
        "shadowColor": "#66A3B2C8",
        "press": "sink",
        "radius": 15,
        "pressedRadius": 15,
        "inset": 2.5,
        "hideHint": true
      },
      "func": {
        "background": { "colors": ["#E8EEF7", "#D9E1EE"], "angle": 135 },
        "pressedBackground": { "colors": ["#D2DBE9", "#E5ECF6"], "angle": 135 },
        "border": "#80FFFFFF",
        "text": "#5B6682"
      },
      "shift": { "text": "#5B6EF5" },
      "enter": {
        "material": "neumorph",
        "background": { "colors": ["#7D90FF", "#5265EC"], "angle": 135 },
        "pressedBackground": "#4759DC",
        "border": "#4DFFFFFF",
        "borderWidth": 0.8,
        "text": "#FFFFFF",
        "shadow": 8,
        "shadowY": 4,
        "shadowColor": "#735265EC"
      }
    },
    "popup": { "radius": 16, "background": "#F4F7FC", "text": "#2D3548", "pressedBackground": "#5B6EF5", "pressedText": "#FFFFFF" },
    "chips": { "material": "none", "text": "#2D3548" },
    "buttons": {
      "material": "neumorph",
      "background": { "colors": ["#F5F8FC", "#E1E7F1"], "angle": 135 },
      "border": "#A6FFFFFF", "borderWidth": 0.8,
      "shadow": 6, "shadowY": 3, "shadowColor": "#66A3B2C8", "text": "#5B6682"
    },
    "panel": {
      "material": "neumorph",
      "background": "#E9EEF6",
      "shadow": 9, "shadowY": 4, "shadowColor": "#66A3B2C8",
      "radius": 24, "inset": 4
    },
    "dark": {
      "keyboard": {
        "background": {
          "colors": ["#1E222B", "#181B23"],
          "angle": 160
        }
      },
      "colors": {
        "background": "#1C2029", "key": "#232833", "keyText": "#E6EBF5",
        "func": "#1E232D", "funcText": "#9BA5BC", "accent": "#7689FF", "accentText": "#FFFFFF"
      },
      "keys": {
        "*": {
          "background": { "colors": ["#282E3A", "#1C2029"], "angle": 135 },
          "pressedBackground": { "colors": ["#171A22", "#242934"], "angle": 135 },
          "border": "#1AFFFFFF",
          "borderWidth": 0.8,
          "shadow": 7,
          "shadowY": 3.5,
          "shadowColor": "#E60C0E14"
        },
        "func": {
          "background": { "colors": ["#222732", "#181C24"], "angle": 135 },
          "border": "#12FFFFFF",
          "text": "#9BA5BC"
        },
        "shift": { "text": "#7689FF" },
        "enter": {
          "background": { "colors": ["#8597FF", "#586CF0"], "angle": 135 },
          "pressedBackground": "#4B5EE2",
          "border": "#33FFFFFF",
          "shadowColor": "#80586CF0"
        }
      },
      "popup": { "background": "#2A303D", "text": "#EEF2FA", "pressedBackground": "#7689FF" },
      "chips": { "text": "#E6EBF5" },
      "buttons": { "background": { "colors": ["#282E3A", "#1C2029"], "angle": 135 }, "border": "#1AFFFFFF", "shadowColor": "#E60C0E14", "text": "#9BA5BC" },
      "panel": { "background": "#1C2029", "shadowColor": "#D90C0E14" }
    }
